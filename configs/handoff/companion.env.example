# SemLink companion handoff profile.
#
# Copy this file to a local .env or export the values before running the
# BlueOS-style package or SITL/UDP handoff scripts.

# Identity
SEMLINK_NODE_ID=boat-alpha
SEMLINK_VEHICLE_ID=boat-alpha
SEMLINK_CALLSIGN=BOAT-ALPHA

# Local API
SEMLINK_HTTP_LISTEN=:80
SEMLINK_BLUEOS_HOST_PORT=8081

# SemStreams runtime
SEMLINK_EMBEDDED_NATS=true
SEMLINK_NATS_STATE_DIR=/data/nats-beta160
NATS_URL=nats://127.0.0.1:4222

# MAVLink input
SEMLINK_MAVLINK_UDP_LISTEN=:14550
SEMLINK_MAVLINK_UDP_HOST=127.0.0.1
SEMLINK_MAVLINK_UDP_PORT=14550

# Simulator fallback when external MAVLink is not configured.
SEMLINK_VEHICLES=1
SEMLINK_HZ=5
SEMLINK_BUFFER=10000

# Mesh peers use absolute peer base URLs. Leave empty for single-node handoff.
SEMLINK_MESH_PEERS=

# Downstream consumers are optional. SemOps and semstreams-ui pull local APIs;
# SemConnect is enabled only when CS_API_URL is set.
CS_API_URL=
SEMLINK_CSAPI_INTERVAL=2s
SEMLINK_CSAPI_OBSERVATION_INTERVAL=5s

# Command posture. Hardware transmit must remain disabled for this change.
SEMLINK_COMMAND_RUNTIME_MODE=hardware-readonly
SEMLINK_HARDWARE_TRANSMIT_ENABLED=false

# Optional TAK bridge controls remain off for the companion handoff profile.
SEMLINK_TAK_ENABLED=false
SEMLINK_TAK_MULTICAST_ADDR=239.2.3.1:6969
SEMLINK_TAK_TCP_LISTEN=
SEMLINK_TAK_INBOUND_UDP_LISTEN=
SEMLINK_TAK_INBOUND_TCP_LISTEN=
SEMLINK_TAK_INTERVAL=1s
