# shellcheck shell=bash
#
# Canonical SemLink ArduPilot SITL container contract.
# Source this file from scripts that build or run the shared SITL image.

export ARDUPILOT_REF="${ARDUPILOT_REF:-Rover-4.6.3}"
export ARDUPILOT_SITL_IMAGE="${ARDUPILOT_SITL_IMAGE:-c360studio/semlink-ardupilot-sitl}"
export ARDUPILOT_SITL_TAG="${ARDUPILOT_SITL_TAG:-rover-4.6.3}"
export ARDUPILOT_VEHICLE="${ARDUPILOT_VEHICLE:-Rover}"
export ARDUPILOT_FRAME="${ARDUPILOT_FRAME:-rover}"
export ARDUPILOT_AIRCRAFT="${ARDUPILOT_AIRCRAFT:-semlink-ardurover}"
export ARDUPILOT_SPEEDUP="${ARDUPILOT_SPEEDUP:-1}"
